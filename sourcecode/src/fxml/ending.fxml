<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" styleClass="game-background" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.EndingController">
   <children>
      <VBox alignment="CENTER" maxHeight="800.0" maxWidth="800.0" spacing="40" styleClass="ending-container">
         <children>
            <Label styleClass="ending-label" text="Game Over!" />
            <Label fx:id="winnerNameLabel" styleClass="ending-label" text="Player 67 wins!" />
            <StackPane maxWidth="250.0" styleClass="avatar-frame">
               <ImageView fx:id="winnerAvatarView" fitHeight="200.0" fitWidth="250.0" />
            </StackPane>
            <HBox alignment="CENTER" spacing="50" style="-fx-background-color: transparent;">
               <children>
                  <Button alignment="CENTER" mnemonicParsing="false" onAction="#goPlay" styleClass="green-play-again-button" text="" />
                  <Button mnemonicParsing="false" onAction="#goHome" styleClass="green-home-button" text="" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
